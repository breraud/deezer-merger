# Copier vers .env A LA RACINE DU DEPLOIEMENT (/opt/deezer-merger/.env sur le
# VPS, en chmod 600). Sert a la substitution de variables de
# docker-compose.yml et d'env_file au conteneur. En local, uvicorn lit aussi
# ce fichier via python-dotenv.
DEEZER_ARL=
PLAYLIST_SOURCE_1=
PLAYLIST_SOURCE_2=
PLAYLIST_SOURCE_3=
PLAYLIST_CIBLE=

# Mot de passe partage de la page de connexion. Obligatoire : sans lui,
# l'application refuse de demarrer. Le changer deconnecte tout le monde.
APP_PASSWORD=

# Tag d'image deploye : ecrit par deploy/deploy.sh au premier deploiement
# reussi, ne pas le renseigner a la main. Preremplir `latest` ferait croire au
# script qu'une version tourne deja, et un premier deploiement rate
# « restaurerait » la nouvelle image. La compose retombe sur `latest` en son
# absence.
# DEEZER_IMAGE_TAG=
